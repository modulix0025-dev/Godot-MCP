<?xml version="1.0" encoding="UTF-8"?>
<!-- ModuleX build worker LaunchAgent. Copy to ~/Library/LaunchAgents/, replace the __PLACEHOLDERS__, then
     `launchctl load ~/Library/LaunchAgents/com.modulex.build-worker.plist`. A LaunchAgent (not a daemon) runs in
     the user session, so xcodebuild can use the login keychain's signing identities. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.modulex.build-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>__WORKER_DIR__/dist/main.js</string>
    <string>serve</string>
    <string>--state</string><string>__HOME__/Library/Application Support/ModuleXBuildWorker</string>
    <string>--godot</string><string>/Applications/Godot_mono.app/Contents/MacOS/Godot</string>
    <string>--signing</string><string>__HOME__/Library/Application Support/ModuleXBuildWorker/signing</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--tls-cert</string><string>__HOME__/Library/Application Support/ModuleXBuildWorker/tls/cert.pem</string>
    <string>--tls-key</string><string>__HOME__/Library/Application Support/ModuleXBuildWorker/tls/key.pem</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/modulex-build-worker.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/modulex-build-worker.log</string>
</dict>
</plist>
