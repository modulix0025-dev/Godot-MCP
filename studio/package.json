{
  "name": "modulex-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "ModuleX Game Studio monorepo workspace (shared schemas, Studio Core, build worker, desktop UI).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "shared",
    "core",
    "worker",
    "claude-desktop",
    "app/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "~4.0.18",
    "jsdom": "^27.0.0",
    "@tauri-apps/cli": "^2.9.0"
  }
}
